rules_version = '2';
// Deploy to tec-main-504c2 (Firestore > Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && request.auth.token.email.lower() == 'p1xelf1n158@outlook.com';
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.banned == false;
      allow update: if isOwner()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if isOwner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
