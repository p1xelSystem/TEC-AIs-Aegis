rules_version = '2';
// Deploy to EACH of tec-chat1 ... tec-chat5 (replaces the earlier chat rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room}/messages/{msg} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20;
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        || (resource.data.authUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content','edited'])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 2000));
      allow delete: if request.auth != null;
    }
    match /rooms/{room}/typing/{uid} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
